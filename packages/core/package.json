{
  "name": "@won005/feedback-core",
  "version": "0.1.0",
  "description": "Portable screen feedback contracts and an in-memory reference adapter",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": ["dist", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepack": "node ../../scripts/copy-notices.mjs",
    "test": "node --test test/*.test.ts"
  },
  "keywords": ["feedback", "annotations", "comments", "adapter"]
}
