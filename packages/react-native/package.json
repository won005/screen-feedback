{
  "name": "@won005/feedback-react-native",
  "version": "0.1.0",
  "description": "Positioned feedback for React Native with a host-provided adapter",
  "license": "MIT",
  "type": "module",
  "files": ["dist", "README.md", "LICENSE", "THIRD_PARTY_NOTICES.md"],
